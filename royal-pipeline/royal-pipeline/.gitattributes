# Shell scripts and Dockerfile-copied files must keep LF endings.
# Git for Windows converts to CRLF by default, and a CRLF shell script fails
# inside a Linux container with the famously unhelpful:
#   /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf
*.sh    text eol=lf
*.sql   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf
*.ps1   text eol=crlf
